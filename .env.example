# Copy to .env and fill in. .env is gitignored; never share it or paste it into chat.
# Use setcreds.py to write values without them showing on screen:
#   python3 setcreds.py IG_ACCESS_TOKEN --clipboard

# Instagram (Meta app dashboard > Instagram > API setup)
IG_ACCESS_TOKEN=
IG_USER_ID=
META_APP_ID=
META_APP_SECRET=

# Cloudflare R2 bucket that holds each photo for the minute Instagram needs it
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set automatically by refresh.py; do not edit by hand.
IG_TOKEN_EXPIRES=
IG_TOKEN_ISSUED=
